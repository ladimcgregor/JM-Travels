# Copy this file to .env and fill in real values before deploying.
# .env is already git-ignored — never commit real keys.

# Web3Forms powers every enquiry form on the site (Bespoke Trip, Contact,
# Consultation, Visa Assistance, Referral) without needing a backend server.
# 1. Create a free account at https://web3forms.com
# 2. Create an access key and restrict it to your production domain
# 3. Paste it below
PUBLIC_WEB3FORMS_KEY=

# Google Analytics 4 Measurement ID (starts with "G-"). Leave blank to disable
# analytics locally; forms and the rest of the site work fine without it.
PUBLIC_GA_MEASUREMENT_ID=

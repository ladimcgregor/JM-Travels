---
import type { CollectionEntry } from "astro:content";

interface Props {
  trip: CollectionEntry<"trips">;
}
const { trip } = Astro.props;
const { title, destination, tripType, duration, startingPrice, heroImage, summary, status } = trip.data;
---

<a href={`/trips/${trip.id}`} class="group block card-surface shadow-soft overflow-hidden reveal">
  <div class="relative aspect-[4/3] overflow-hidden">
    <img
      src={heroImage}
      alt={`${title}, ${destination}`}
      loading="lazy"
      width="900"
      height="675"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    {status === "limited" && (
      <span class="absolute top-3 left-3 badge bg-gold text-navy-dark">Limited spaces</span>
    )}
  </div>
  <div class="p-6">
    <p class="text-label text-gold">{destination}</p>
    <h3 class="text-h3 mt-2">{title}</h3>
    <p class="text-body-s text-slate mt-2 line-clamp-2">{summary}</p>
    <div class="flex items-center justify-between mt-4 pt-4 border-t border-mist">
      <div class="flex flex-wrap gap-2 text-body-s text-slate">
        <span>{duration}</span>
        <span aria-hidden="true">&middot;</span>
        <span>{tripType.join(" / ")}</span>
      </div>
    </div>
    {startingPrice && <p class="text-body-s font-semibold text-navy mt-2">{startingPrice}</p>}
  </div>
</a>

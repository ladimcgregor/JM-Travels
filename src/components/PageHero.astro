---
interface Props {
  title: string;
  image: string;
  imageAlt?: string;
}
const { title, image, imageAlt = "" } = Astro.props;
---

<section class="relative h-[46vh] min-h-[340px] flex items-end bg-navy-dark overflow-hidden" data-scroll-img>
  <img src={image} alt={imageAlt} class="absolute inset-0 w-full h-full object-cover opacity-80" fetchpriority="high" />
  <div class="absolute inset-0 bg-gradient-to-t from-navy-dark via-navy-dark/35 to-transparent"></div>
  <div class="container-jm relative pb-10 text-white">
    <h1 class="text-display-xl text-white max-w-2xl">{title}</h1>
    <slot />
  </div>
</section>

---
import { site, whatsappLink, whatsappMessages } from "@/config/site";

interface Props {
  message?: string;
}
const { message = whatsappMessages.general } = Astro.props;
---

<a
  href={whatsappLink(message)}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Message ${site.name} on WhatsApp`}
  class="hover-grow fixed z-40 bottom-5 right-5 md:bottom-8 md:right-8 flex items-center justify-center w-14 h-14 rounded-full shadow-soft"
  style="background:#25d366;"
>
  <svg width="28" height="28" viewBox="0 0 24 24" fill="#0b3d20"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20zm4.4-6c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1-.2.2-.6.8-.8 1-.1.1-.3.2-.5.1-.2-.1-1-.4-1.9-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.3.1-.5.1-.1.2-.3.3-.4.1-.1.2-.2.2-.4.1-.1 0-.3 0-.4-.1-.1-.5-1.2-.7-1.7-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9s.9 2.2 1 2.3c.1.2 1.7 2.6 4.1 3.6.6.2 1 .4 1.4.5.6.2 1.1.1 1.5.1.5-.1 1.4-.6 1.6-1.1.2-.5.2-1 .1-1.1-.1-.1-.2-.2-.4-.3z"/></svg>
  <span class="sr-only">Message us on WhatsApp</span>
</a>

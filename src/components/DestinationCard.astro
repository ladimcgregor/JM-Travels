---
import type { CollectionEntry } from "astro:content";

interface Props {
  destination: CollectionEntry<"destinations">;
}
const { destination } = Astro.props;
const { country, city, heroImage } = destination.data;
---

<a href={`/destinations/${destination.id}`} class="hover-grow group relative block aspect-[3/4] overflow-hidden rounded-md reveal">
  <img
    src={heroImage}
    alt={city ? `${city}, ${country}` : country}
    loading="lazy"
    width="600"
    height="800"
    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
  />
  <div class="absolute bottom-0 left-0 right-0 p-5">
    <p class="text-white font-display text-xl font-semibold" style="text-shadow: 0 1px 3px rgba(8,28,44,0.85), 0 4px 16px rgba(8,28,44,0.5);">{city ?? country}</p>
    {city && <p class="text-white/90 text-body-s" style="text-shadow: 0 1px 3px rgba(8,28,44,0.85);">{country}</p>}
  </div>
</a>

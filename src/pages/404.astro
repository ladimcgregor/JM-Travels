---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
---

<BaseLayout title="Page Not Found" description="This page doesn't exist." noindex>
  <section class="py-24 md:py-40 text-center">
    <div class="container-jm max-w-lg mx-auto">
      <h1 class="text-display-l">This page has wandered off.</h1>
      <p class="text-body-l text-slate mt-4">
        The page you're looking for doesn't exist or has moved. Let's get you back on track.
      </p>
      <div class="flex flex-wrap justify-center gap-4 mt-8">
        <Button href="/" variant="primary">Back to Home</Button>
        <Button href="/contact" variant="secondary">Contact Us</Button>
      </div>
    </div>
  </section>
</BaseLayout>

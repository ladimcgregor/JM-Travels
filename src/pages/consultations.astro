---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import EnquiryForm from "@/components/forms/EnquiryForm.tsx";

const scenarios = [
  "I know where I want to go but don't know how to plan it.",
  "I need help choosing a destination.",
  "I want to know whether my itinerary makes sense.",
  "I need help understanding the visa process.",
  "I want to plan a group trip.",
  "I want someone to coordinate the trip for me.",
];
---

<BaseLayout
  title="Travel Consultations"
  description="Book a travel consultation with JM Travels for expert guidance before you book or travel."
>
  <PageHero
    title="Expert guidance before you book or travel."
    image="/images/photos/lagos-street.jpg"
    imageAlt="A travel consultation in progress"
  />

  <section class="pt-12 pb-4">
    <div class="container-jm">
      <p class="text-body-l text-slate max-w-2xl">A consultation might be right for you if:</p>
      <ul class="grid sm:grid-cols-2 gap-4 max-w-3xl mt-8">
        {scenarios.map((s) => (
          <li class="card-surface shadow-soft p-4 text-body text-charcoal reveal">"{s}"</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-jm max-w-2xl">
      <EnquiryForm client:visible variant="consultation" />
    </div>
  </section>
</BaseLayout>

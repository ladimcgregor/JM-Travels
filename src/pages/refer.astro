---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import EnquiryForm from "@/components/forms/EnquiryForm.tsx";
---

<BaseLayout
  title="Refer Someone"
  description="Know someone planning a trip? Refer them to JM Travels."
>
  <PageHero
    eyebrow="Refer Someone"
    title="Good trips are worth talking about."
    image="https://picsum.photos/seed/jm-hero-refer/1920/1100"
    imageAlt="Friends planning a trip together"
  >
    <p class="text-body-l text-white/85 mt-4 max-w-xl">
      Many of our journeys begin with a recommendation. If you've travelled with us or worked with us, we'd love
      to help someone in your circle plan their next adventure.
    </p>
  </PageHero>

  <section class="py-16 md:py-24">
    <div class="container-jm max-w-2xl">
      <EnquiryForm client:visible variant="referral" />
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Button from "@/components/Button.astro";
import { site } from "@/config/site";

const approach = [
  { title: "Listen", description: "Understand what you actually want from the trip, not just the destination.", image: "https://picsum.photos/seed/jm-approach-1/300/300" },
  { title: "Plan", description: "Design an itinerary that reflects your priorities, pace and budget.", image: "https://picsum.photos/seed/jm-approach-2/300/300" },
  { title: "Coordinate", description: "Bring accommodation, transport, activities and documentation together.", image: "https://picsum.photos/seed/jm-approach-3/300/300" },
  { title: "Support", description: "Stay reachable before and during your trip, not just up to booking.", image: "https://picsum.photos/seed/jm-approach-4/300/300" },
  { title: "Learn", description: "Capture what worked and what didn't, so the next trip is better than the last.", image: "https://picsum.photos/seed/jm-approach-5/300/300" },
];

const buildingBlocks = [
  { title: "Destination knowledge", description: "Every trip sharpens our understanding of a place: timing, logistics, what's worth it.", image: "https://picsum.photos/seed/jm-building-1/700/500" },
  { title: "Supplier knowledge", description: "We learn which hotels, drivers and operators are genuinely reliable.", image: "https://picsum.photos/seed/jm-building-2/700/500" },
  { title: "Customer insight", description: "Every conversation teaches us more about what travellers actually need.", image: "https://picsum.photos/seed/jm-building-3/700/500" },
  { title: "Travel content", description: "Real trips create real guides, tips and stories for future travellers.", image: "https://picsum.photos/seed/jm-building-4/700/500" },
  { title: "Operational experience", description: "Each trip refines the process behind the next one.", image: "https://picsum.photos/seed/jm-building-5/700/500" },
];
---

<BaseLayout
  title="About JM Travels"
  description="Meet Jemima, the Lead Traveller behind JM Travels, and learn how practical travel experience across 10 countries became a travel planning business."
>
  <PageHero
    eyebrow="Our Story"
    title="Why JM Travels was created."
    image="https://picsum.photos/seed/jm-hero-about/1920/1100"
    imageAlt="The beginning of the JM Travels story"
  >
    <p class="text-body-l text-white/85 mt-4 max-w-xl">
      JM Travels is a new business, but it isn't starting from zero in travel experience. It exists because
      planning a trip properly is a skill, and not everyone wants to spend their time building it themselves.
    </p>
  </PageHero>

  <section class="py-16 md:py-24 bg-sand">
    <div class="container-jm grid lg:grid-cols-2 gap-12 items-center">
      <div class="hover-grow reveal rounded-md" data-scroll-img>
        <img
          src={site.founder.photo}
          onerror="this.src='https://picsum.photos/seed/jm-founder-about/1000/1200'"
          alt={site.founder.name}
          loading="lazy"
          width="1000"
          height="1200"
          class="w-full aspect-[4/5] object-cover rounded-md shadow-soft"
        />
      </div>
      <div class="reveal">
        <p class="eyebrow">Meet the Lead Traveller</p>
        <h2 class="text-h1 mt-4">{site.founder.name}</h2>
        <p class="text-body-l text-slate mt-6">
          Jemima has travelled across 10 countries and planned trips for family and friends: real, practical
          experience with the decisions involved in travel planning, from destination selection and itinerary
          structure to activities, logistics and coordinating multiple moving parts.
        </p>
        <p class="text-body-l text-slate mt-4">
          That experience is presented as the starting point of JM Travels' expertise, not as a long-established
          corporate track record. The credibility here is straightforward: genuine travel experience, a real
          understanding of the practicalities, and a business built specifically to do this well for other people.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-jm grid lg:grid-cols-2 gap-12 items-center">
      <div class="reveal">
        <p class="eyebrow">The Travel Experience</p>
        <h2 class="text-h1 mt-4">10 countries. Countless small lessons.</h2>
        <p class="text-body-l text-slate mt-6">
          Travelling across 10 countries doesn't make anyone an expert on every destination, but it does build
          practical, transferable judgement: how to sequence a trip, what's worth the time, how to plan around a
          budget, and what questions actually matter when preparing to travel. That judgement is what gets applied to
          every JM Travels itinerary, whether or not Jemima has personally been to that specific destination.
        </p>
        <div class="mt-8">
          <Button href="/destinations" variant="secondary">See the destinations</Button>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3 reveal">
        <div class="hover-grow rounded-md shadow-soft overflow-hidden translate-y-6" data-scroll-img>
          <img src="https://picsum.photos/seed/jm-travelexp-1/600/750" alt="A moment from a JM Travels planning journey" loading="lazy" width="600" height="750" class="w-full aspect-[4/5] object-cover" />
        </div>
        <div class="hover-grow rounded-md shadow-soft overflow-hidden" data-scroll-img>
          <img src="https://picsum.photos/seed/jm-travelexp-2/600/750" alt="Travel notes and itinerary planning" loading="lazy" width="600" height="750" class="w-full aspect-[4/5] object-cover" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-navy-dark text-white">
    <div class="container-jm max-w-3xl">
      <p class="eyebrow text-gold-light">The Philosophy</p>
      <h2 class="text-h1 mt-4 text-white">Travel is better when the details are thoughtfully planned.</h2>
      <p class="text-body-l text-white/80 mt-6">
        Most people don't struggle to want to travel; they struggle to plan it with confidence. JM Travels exists
        to close that gap: not by pretending to have decades of history, but by being honest about where the
        business is starting from, and building on it properly, one trip at a time.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-jm">
      <p class="eyebrow">Our Approach</p>
      <h2 class="text-h1 mt-4 max-w-2xl">Five steps, applied to every trip we plan.</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-8 mt-12">
        {approach.map((item, i) => (
          <div class="reveal">
            <div class="hover-grow relative w-16 h-16 rounded-full">
              <img src={item.image} alt="" aria-hidden="true" loading="lazy" width="128" height="128" class="w-16 h-16 rounded-full object-cover shadow-soft" />
              <span class="absolute -bottom-2 -right-2 flex items-center justify-center w-7 h-7 rounded-full bg-navy text-white text-body-s font-display font-semibold">
                {i + 1}
              </span>
            </div>
            <h3 class="text-h4 text-navy mt-5">{item.title}</h3>
            <p class="text-body-s text-slate mt-2">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-sand">
    <div class="container-jm">
      <p class="eyebrow">Building Through Every Journey</p>
      <h2 class="text-h1 mt-4 max-w-2xl">Every trip contributes to something bigger than one customer.</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4 mt-12">
        {buildingBlocks.map((item) => (
          <div class="card-surface shadow-soft overflow-hidden reveal group">
            <div class="aspect-[7/5] overflow-hidden">
              <img src={item.image} alt="" aria-hidden="true" loading="lazy" width="700" height="500" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110" />
            </div>
            <div class="p-5">
              <h3 class="text-h4 text-navy">{item.title}</h3>
              <p class="text-body-s text-slate mt-2">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 text-center">
    <div class="container-jm max-w-xl mx-auto reveal">
      <h2 class="text-h1">Let's plan your trip properly.</h2>
      <div class="flex flex-wrap justify-center gap-4 mt-8">
        <Button href="/bespoke-travel" variant="primary">Plan My Trip</Button>
        <Button href="/contact" variant="secondary">Get in Touch</Button>
      </div>
    </div>
  </section>
</BaseLayout>

---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Button from "@/components/Button.astro";
import TestimonialCard from "@/components/TestimonialCard.astro";

const testimonials = await getCollection("testimonials");
---

<BaseLayout
  title="Testimonials"
  description="Real feedback from JM Travels customers, published only with their permission."
>
  <PageHero
    title="What travelling with us has been like."
    image="/images/photos/serengeti-migration-2.jpg"
    imageAlt="A JM Travels customer experience"
  >
    <p class="text-body-l text-white/85 mt-4 max-w-xl">
      Every testimonial here is genuine and published with the customer's permission. We'd rather show fewer real
      stories than manufacture credibility we haven't earned yet.
    </p>
  </PageHero>

  <section class="py-16 md:py-24">
    <div class="container-jm">
      {testimonials.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {testimonials.map((t) => <TestimonialCard testimonial={t} />)}
        </div>
      ) : (
        <div class="grid lg:grid-cols-2 gap-6 items-stretch">
          <div class="rounded-md shadow-soft overflow-hidden min-h-[260px]" data-scroll-img>
            <img
              src="/images/photos/serengeti-migration.jpg"
              alt="A trip currently being planned by JM Travels"
              loading="lazy"
              width="1000"
              height="800"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="card-surface shadow-soft p-10 flex flex-col justify-center">
            <p class="text-h2 text-navy">We're building our track record, honestly.</p>
            <p class="text-body-l text-slate mt-4">
              Every testimonial published here is genuine and shared with the customer's permission. As more trips
              wrap up, real feedback will appear here. In the meantime, we'd rather earn your trust through how we
              handle your enquiry than through quotes we haven't earned.
            </p>
            <div class="mt-6">
              <Button href="/bespoke-travel" variant="primary">Start Planning Your Trip</Button>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

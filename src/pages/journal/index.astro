---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const articles = (await getCollection("journal"))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categories = [...new Set(articles.map((a) => a.data.category))];
---

<BaseLayout
  title="Travel Journal"
  description="Destination guides, visa guides, itinerary ideas and travel tips from JM Travels."
>
  <section class="pt-16 pb-12 md:pt-24 md:pb-16">
    <div class="container-jm max-w-2xl">
      <p class="eyebrow">Travel Journal</p>
      <h1 class="text-h1 mt-4">Guides, tips and lessons from the road.</h1>
      <p class="text-body-l text-slate mt-6">
        A growing library of practical travel knowledge — destination guides, visa checklists, itinerary ideas and
        honest travel tips.
      </p>
    </div>
  </section>

  <section class="pb-20 md:pb-28">
    <div class="container-jm">
      <div class="flex flex-wrap gap-2 mb-10">
        {categories.map((cat) => (
          <span class="badge">{cat}</span>
        ))}
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {articles.map((article) => (
          <a href={`/journal/${article.id}`} class="group block reveal">
            <div class="aspect-[4/3] overflow-hidden rounded-md">
              <img
                src={article.data.heroImage}
                alt={article.data.title}
                loading="lazy"
                width="900"
                height="675"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <p class="text-label text-gold mt-4">{article.data.category}</p>
            <h2 class="text-h4 text-navy mt-2 group-hover:text-gold transition-colors">{article.data.title}</h2>
            <p class="text-body-s text-slate mt-2">{article.data.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

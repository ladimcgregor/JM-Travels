---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import { site, whatsappLink, whatsappMessages } from "@/config/site";

// The homepage is deliberately short: four sections that say what we do, why
// we're worth talking to, and how to start. Trips, destinations, testimonials,
// the journal and the full process live on their own pages; the goal here is to
// prompt a conversation, not answer every question up front.

const whatWeDo = [
  {
    title: "Organised Trips",
    description: "Curated travel experiences you can simply join.",
    cta: "Explore Trips",
    href: "/trips",
    image: "/images/photos/serengeti-migration.jpg",
    span: "lg:col-span-2 lg:row-span-2",
  },
  {
    title: "Bespoke Trips",
    description: "Personalised journeys designed around you.",
    cta: "Create My Trip",
    href: "/bespoke-travel",
    image: "/images/photos/luxury-resort-aerial.jpg",
    span: "lg:col-span-2 lg:row-span-1",
  },
  {
    title: "Visa Assistance",
    description: "Support through the visa preparation process.",
    cta: "Get Visa Support",
    href: "/visa-assistance",
    image: "/images/photos/middle-east-architecture.jpg",
    span: "lg:col-span-1 lg:row-span-1",
  },
  {
    title: "Travel Consultations",
    description: "Expert guidance before you book or travel.",
    cta: "Book a Consultation",
    href: "/consultations",
    image: "/images/photos/lagos-street.jpg",
    span: "lg:col-span-1 lg:row-span-1",
  },
];

const reasons = [
  { title: "Planned around you", note: "Your priorities, pace and budget, not a template." },
  { title: "One point of contact", note: "Stays, transfers, activities and visas, coordinated in one place." },
  { title: "Support beyond booking", note: "Reachable before and during your trip." },
];

const steps = ["Tell us the basics", "We send a tailored plan", "You travel, we stay on call"];

const destinationMarquee = [
  "Zanzibar",
  "Dubai",
  "Cape Town",
  "Santorini",
  "Bali",
  "Victoria Falls",
  "Paris",
  "Doha",
  "Tokyo",
  "Maldives",
  "Petra",
  "Amalfi Coast",
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  name: site.name,
  description: site.description,
  email: site.contact.email,
  telephone: site.contact.phoneDisplay,
  areaServed: site.contact.location,
  sameAs: [site.social.instagram, site.social.tiktok],
};
---

<BaseLayout
  title={`${site.name}: ${site.tagline}`}
  description={site.description}
  transparentNav
  structuredData={structuredData}
>
  <!-- 1. HERO (destination ticker sits along its bottom edge) -->
  <section class="relative min-h-[92vh] flex flex-col justify-end bg-navy-dark overflow-hidden">
    <img
      src="/images/photos/cape-town-table-mountain.jpg"
      alt="Table Mountain above Cape Town at dusk"
      class="hero-kenburns absolute inset-0 w-full h-full object-cover opacity-85"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-navy-dark via-navy-dark/35 to-navy-dark/15"></div>
    <div class="container-wide relative pb-14 pt-28 text-white">
      <h1 class="text-hero-xl max-w-5xl text-white">Travel better. We'll plan the details.</h1>
      <p class="text-body-l mt-6 max-w-xl text-white/85">
        From curated group experiences to completely bespoke trips, JM Travels helps you plan, coordinate and
        experience travel with confidence.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <Button href={site.primaryCta.href} variant="gold">Plan My Trip</Button>
        <Button
          href="/trips"
          variant="secondary"
          class="!bg-transparent !text-white !border-white hover:!bg-white hover:!text-navy"
        >
          Explore Our Trips
        </Button>
      </div>
    </div>

    <div class="relative bg-navy-dark/80 py-4 border-t border-white/10" data-marquee data-marquee-duration="32" aria-hidden="true">
      <div class="flex gap-10 pr-10" data-marquee-track>
        {[...destinationMarquee, ...destinationMarquee].map((name) => (
          <span class="flex items-center gap-10 shrink-0 font-display text-xl md:text-2xl text-white/70 tracking-wide">
            {name}
            <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. WHAT WE DO -->
  <section class="py-16 md:py-24">
    <div class="container-jm">
      <div class="flex items-end justify-between gap-6 flex-wrap reveal">
        <h2 class="text-display-l max-w-2xl">Everything between "I want to travel" and actually going.</h2>
        <a href="/services" class="inline-flex items-center gap-1 text-body-s font-semibold text-navy transition-transform duration-300 hover:translate-x-1">
          All services →
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 lg:grid-rows-2 lg:grid-flow-dense gap-4 mt-12">
        {whatWeDo.map((item) => (
          <a href={item.href} class={`hover-grow group relative block overflow-hidden rounded-md shadow-soft reveal min-h-[220px] ${item.span}`}>
            <img
              src={item.image}
              alt={item.title}
              loading="lazy"
              width="1200"
              height="1200"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-dark/90 via-navy-dark/25 to-transparent"></div>
            <div class="relative h-full flex flex-col justify-end p-6">
              <h3 class="text-h4 text-white">{item.title}</h3>
              <p class="text-body-s text-white/75 mt-2 max-w-xs">{item.description}</p>
              <span class="inline-flex items-center gap-1 text-body-s font-semibold text-gold-light mt-4 transition-transform duration-300 group-hover:translate-x-1">
                {item.cta} →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. WHY JM TRAVELS (led by Jemima) -->
  <section class="py-16 md:py-24 bg-sand">
    <div class="container-jm grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="relative reveal">
        <div class="hover-grow rounded-md overflow-hidden shadow-soft" data-scroll-img>
          <img
            src={site.founder.photo}
            onerror="this.src='/images/founder/founder-placeholder.jpg'"
            alt={`${site.founder.name}, Lead Traveller at JM Travels`}
            loading="lazy"
            width="1000"
            height="1200"
            class="w-full aspect-[4/5] object-cover"
          />
        </div>
        <p class="absolute bottom-4 left-4 rounded-full bg-warm-white px-4 py-2 text-body-s font-semibold text-navy shadow-soft">
          {site.founder.name}, Lead Traveller
        </p>
      </div>

      <div class="reveal">
        <h2 class="text-display-l">Travel planning should feel exciting, not overwhelming.</h2>
        <p class="text-body-l text-slate mt-6">
          Every JM Travels trip is personally led by {site.founder.name}, who has spent years travelling widely and
          planning trips for family and friends. You tell us where you want to go; we handle the details.
        </p>

        <ul class="divide-y divide-mist border-y border-mist mt-8">
          {reasons.map((r, i) => (
            <li class="flex items-baseline gap-5 py-4">
              <span class="font-display text-h4 text-gold shrink-0 w-7">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <p class="text-h4 text-navy">{r.title}</p>
                <p class="text-body-s text-slate mt-1">{r.note}</p>
              </div>
            </li>
          ))}
        </ul>

        <div class="mt-8">
          <Button href="/about" variant="secondary">Meet {site.founder.name}</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. FINAL CTA -->
  <section class="relative py-24 md:py-32 bg-navy-dark text-white overflow-hidden" data-scroll-img>
    <img
      src="/images/photos/dakar-monument.jpg"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover opacity-30"
    />
    <div class="container-jm relative text-center max-w-3xl mx-auto reveal">
      <h2 class="text-display-l text-white">Where are you going next?</h2>
      <p class="text-body-l text-white/80 mt-5">
        Tell us where and roughly when, or what you need help with.
        We'll come back within {site.responseTimePromise} with a plan worth talking about.
      </p>

      <ol class="grid sm:grid-cols-3 gap-4 mt-10 text-left sm:text-center">
        {steps.map((step, i) => (
          <li class="flex sm:flex-col items-center gap-3">
            <span class="flex items-center justify-center w-9 h-9 shrink-0 rounded-full border border-white/40 font-display font-semibold">
              {i + 1}
            </span>
            <span class="text-body-s text-white/85">{step}</span>
          </li>
        ))}
      </ol>

      <div class="flex flex-wrap justify-center gap-4 mt-10">
        <Button href={site.primaryCta.href} variant="gold">Plan My Trip</Button>
        <Button
          href={site.servicesCta.href}
          variant="secondary"
          class="!bg-transparent !text-white !border-white hover:!bg-white hover:!text-navy"
        >
          {site.servicesCta.label}
        </Button>
        <Button href={whatsappLink(whatsappMessages.general)} variant="whatsapp" target="_blank" rel="noopener noreferrer">
          WhatsApp {site.name}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
